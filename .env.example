# ============================
# 数据库配置
# ============================
# 本地开发 (SQLite)
# DATABASE_URL="file:./dev.db"

# 生产环境 (PostgreSQL / Supabase)
# 格式: postgresql://用户名:密码@主机地址:端口/数据库名?schema=public
# Supabase 示例: postgresql://postgres:你的密码@db.xxxxxxxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# ============================
# JWT 配置
# ============================
JWT_SECRET="change-this-to-a-random-string"

# ============================
# CORS 跨域配置
# ============================
# 本地开发
CORS_ORIGIN="http://localhost:5173"
# 生产环境改为 Vercel 前端地址，例如:
# CORS_ORIGIN="https://novel-frontend.vercel.app"

# ============================
# 服务端口
# ============================
PORT=3001
